PORT=5000
# development | production. In production JWT_SECRET must be 32+ characters or the server refuses to start.
NODE_ENV=development
# Atlas: Connect -> Drivers -> copy the connection string, add DB name "farmlink". Special characters in the password must be URL-encoded (@ = %40).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/farmlink?retryWrites=true&w=majority
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
# The browser origin that is allowed to call the API (dev: the Vite URL; production with the Docker image: the site's own URL)
CLIENT_URL=http://localhost:5173
# Only needed if your network's DNS cannot resolve Atlas mongodb+srv addresses
DNS_SERVERS=8.8.8.8,1.1.1.1

ADMIN_NAME=FarmLink Admin
ADMIN_PHONE=9000000000
ADMIN_EMAIL=admin@farmlink.local
ADMIN_PASSWORD=choose_a_strong_password

# ---- Email (sign-up codes, forgot password, change email) ----
# Pick ONE way to send. With neither, codes are only printed in the server log and, in development, shown on screen (never in production).
#
# Option A, Brevo API (recommended; works on hosts that block SMTP ports). Key looks like xkeysib-...
BREVO_API_KEY=
# Option B, SMTP. Brevo: smtp-relay.brevo.com, port 587, user = the SMTP login shown in Brevo, password = an SMTP key.
# Gmail: smtp.gmail.com, port 587, your address + an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The "from" address. With Brevo it MUST be a sender you verified in Brevo (Senders, Domains & Dedicated IPs -> Senders).
MAIL_FROM=FarmLink <your-verified-sender@example.com>

# Mandi prices: free key from https://data.gov.in (My Account > API key). Blank = use admin-entered prices only
DATA_GOV_API_KEY=

# Where uploaded crop photos and ID documents are stored. Default: server/uploads. In Docker/hosting, point it at a persistent disk.
UPLOAD_DIR=

# Request limits (per IP). Defaults: 30 login/register attempts per 15 min, 600 API requests per minute
AUTH_RATE_LIMIT=
API_RATE_LIMIT=
